{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "username", "email", "role", "full_name"],
  "properties": {
    "id": { "type": "integer" },
    "username": { "type": "string" },
    "email": { "type": "string" },
    "role": { "type": "string", "enum": ["Administrator", "Doctor", "Nurse", "Patient"] },
    "full_name": { "type": "string" },
    "phone": { "type": ["string", "null"] },
    "created_at": { "type": "string" }
  }
}
