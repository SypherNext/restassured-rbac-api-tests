{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "username", "email", "full_name"],
    "properties": {
      "id": { "type": "integer" },
      "username": { "type": "string" },
      "email": { "type": "string" },
      "full_name": { "type": "string" },
      "phone": { "type": ["string", "null"] },
      "created_at": { "type": "string" }
    }
  }
}
